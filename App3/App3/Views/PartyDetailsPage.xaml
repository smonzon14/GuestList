<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:magic="clr-namespace:MagicGradients;assembly=MagicGradients"
             xmlns:local="clr-namespace:App3" xmlns:converters="clr-namespace:App3.Converters" xmlns:models="clr-namespace:App3.Models"
             mc:Ignorable="d"
             x:Class="App3.PartyDetailsPage"
             NavigationPage.HasNavigationBar="False"
             ControlTemplate="{StaticResource hiddenBarTemplate}">
    <ContentPage.Resources>
        <Color x:Key="defaultTint">#ffff00ff</Color>
        <Color x:Key="defaultDeselected">#ffffffff</Color>
    </ContentPage.Resources>
    <ContentPage.Content>
        <AbsoluteLayout>
            <ListView ItemTemplate="{StaticResource commentTemplate}" HasUnevenRows="True" x:Name="partyDetailsListView" VerticalScrollBarVisibility="Never" SeparatorVisibility="None" AbsoluteLayout.LayoutFlags="All"  AbsoluteLayout.LayoutBounds="0,0,1,1" BackgroundColor="Black" Margin="0,-30,0,0" IsPullToRefreshEnabled="True" RefreshControlColor="White" Refreshing="partyDetailsListView_Refreshing">
                <ListView.Footer>
                    <StackLayout Padding="20,20,20,50" BackgroundColor="Black">
                        <Frame CornerRadius="20" Padding="10,0,10,10" BackgroundColor="#202020" HasShadow="False">
                            <StackLayout>
                                <ProgressBar x:Name="progressBar" ProgressColor="#F50058" Progress="0"/>
                                <Editor x:Name="message" MaxLength="200" BackgroundColor="Transparent" Placeholder="Let people know what's up!" TextColor="White" FontSize="16" AutoSize="TextChanges" PlaceholderColor="Gray" MinimumHeightRequest="100" Keyboard="Chat"/>

                                <StackLayout HorizontalOptions="Fill" Orientation="Horizontal">
                                    <Label Text="{Binding Text.Length, Source={x:Reference message}, FallbackValue='0/200', StringFormat='{0}/200'}" TextColor="Gray" HorizontalOptions="StartAndExpand" VerticalOptions="Center" FontSize="16"/>

                                    <Frame Padding="0" BackgroundColor="Transparent" HorizontalOptions="End" HeightRequest="30" CornerRadius="15">
                                        <Button Text="Send" FontSize="14" TextColor="#F50058" BackgroundColor="White" Padding="10" Clicked="SendCommentButtonClicked"/>
                                    </Frame>

                                </StackLayout>

                            </StackLayout>
                        </Frame>
                    </StackLayout>

                </ListView.Footer>
                <ListView.Header>
                    <StackLayout Spacing="0">
                        <AbsoluteLayout HeightRequest="400">
                            <Image Source="{Binding ImageSource}" Aspect="AspectFill" AbsoluteLayout.LayoutFlags="All"  AbsoluteLayout.LayoutBounds="0,0,1,1"/>

                            <magic:GradientView AbsoluteLayout.LayoutBounds="1,1,1,0.7" AbsoluteLayout.LayoutFlags="All">
                                <magic:GradientView.GradientSource >
                                    <magic:CssGradientSource>
                                        <x:String>
                                            <![CDATA[
                    linear-gradient(to top, #ff000000, #00000000)
                            ]]>
                                        </x:String>
                                    </magic:CssGradientSource>
                                </magic:GradientView.GradientSource>
                            </magic:GradientView>

                            <StackLayout Orientation="Horizontal" AbsoluteLayout.LayoutBounds="0,1,1,1" AbsoluteLayout.LayoutFlags="All">

                                <StackLayout HorizontalOptions="FillAndExpand" Spacing="5" Padding="20,0,20,0" >


                                    <Label Text="{Binding name}" TextColor="White" FontAttributes="Bold" FontSize="35" LineBreakMode="WordWrap" MaxLines="2" VerticalOptions="EndAndExpand"/>

                                    
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <Image Source="tab_map" HeightRequest="18"/>
                                        <Label Text="{Binding address}" FontSize="18" HorizontalOptions="StartAndExpand" TextColor="White" LineBreakMode="WordWrap" />
                                    </StackLayout>
                                    <Label Text="{Binding time}" FontSize="16" TextColor="DeepSkyBlue"  HorizontalTextAlignment="Start" FontAttributes="Italic"/>
                                    <StackLayout HorizontalOptions="Fill" Orientation="Horizontal" Padding="10">
                                        <StackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                        </StackLayout.GestureRecognizers>
                                        <Frame WidthRequest="30" HeightRequest="30" CornerRadius="15" HorizontalOptions="Start" Padding="0" IsClippedToBounds="True" Grid.Column="0">
                                            <Image Aspect="AspectFill" Source="{Binding Path=Thrower.ProfileImageSource}"/>
                                        </Frame>
                                        <Label Text="{Binding Path=Thrower.name}" FontSize="18" TextColor="White" VerticalOptions="Center"/>
                                    </StackLayout>
                                </StackLayout>
                                <StackLayout Padding="20"  HorizontalOptions="Center" VerticalOptions="EndAndExpand">
                                    <Frame CornerRadius="35" Padding="0" >
                                        <Button WidthRequest="70" HeightRequest="70" Command="{Binding GoCommand}" CommandParameter="{Binding .}" Padding="0" FontAttributes="Bold">
                                            <Button.FontSize>
                                                <Binding Path="Going">
                                                    <Binding.Converter>
                                                        <converters:BoolToObjectConverter x:TypeArguments="x:Int16"
                                                                                      TrueObject="14"
                                                                                      FalseObject="25"/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </Button.FontSize>
                                            <Button.Text>
                                                <Binding Path="Going">
                                                    <Binding.Converter>
                                                        <converters:BoolToObjectConverter x:TypeArguments="x:String"
                                                                                          TrueObject="Back Out"
                                                                                          FalseObject="GO"/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </Button.Text>
                                            <Button.TextColor>
                                                <Binding Path="Going">
                                                    <Binding.Converter>
                                                        <converters:BoolToObjectConverter x:TypeArguments="Color"
                                                                                      TrueObject="#F50058"
                                                                                      FalseObject="White"/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </Button.TextColor>

                                        </Button>
                                        <Frame.BackgroundColor>
                                            <Binding Path="Going">
                                                <Binding.Converter>
                                                    <converters:BoolToObjectConverter x:TypeArguments="Color"
                                                                                      TrueObject="White"
                                                                                      FalseObject="#F50058"/>
                                                </Binding.Converter>
                                            </Binding>
                                        </Frame.BackgroundColor>
                                    </Frame>

                                </StackLayout>

                            </StackLayout>




                        </AbsoluteLayout>



                        <StackLayout Padding="20,10,20,10" Spacing="20">
                            
                            <Label Text="Demographics" FontSize="20" TextColor="White" FontAttributes="Bold"/>
                            <Frame Padding="0" CornerRadius="40" BackgroundColor="#202020">

                                <StackLayout Spacing="10" Padding="20">
                                    <StackLayout Orientation="Horizontal">
                                        <StackLayout HorizontalOptions="CenterAndExpand">
                                            <Label Text="101" TextColor="#F50058" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                            <Label Text="Total" TextColor="#F50058" FontSize="14"  HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="CenterAndExpand">
                                            <Label Text="19" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                            <Label Text="Avg. Age" TextColor="White" FontSize="14"  HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="CenterAndExpand">
                                            <Label Text="50" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                            <Label Text="% Women" TextColor="White" FontSize="14"  HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                        <StackLayout HorizontalOptions="CenterAndExpand">
                                            <Label Text="50" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                            <Label Text="% Men" TextColor="White" FontSize="14"  HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </StackLayout>
                                </StackLayout>
                            </Frame>
                            <Label Text="Location" FontSize="20" TextColor="White" FontAttributes="Bold"/>
                            <Frame Padding="0" CornerRadius="40">
                                <models:PartyMap x:Name="map" IsVisible="true"  HeightRequest="300" IsEnabled="False"/>
                            </Frame>
                            <!--
                            Commenting field
                            -->

                            <Label Text="Comments" FontSize="20" TextColor="White" FontAttributes="Bold"/>
                            

                        </StackLayout>



                    </StackLayout>

                </ListView.Header>
            </ListView>
            
            
        </AbsoluteLayout>
        
        
    </ContentPage.Content>
</ContentPage>