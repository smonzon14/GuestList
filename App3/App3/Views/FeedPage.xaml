<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:magic="clr-namespace:MagicGradients;assembly=MagicGradients"
             xmlns:converters="clr-namespace:App3.Converters"
             mc:Ignorable="d"
             x:Class="App3.Views.FeedPage"
             NavigationPage.HasNavigationBar="False"
             Title="My Invites"
             ControlTemplate="{StaticResource minimizedBarTemplate}">
    <ContentPage.Resources>
        <converters:FeedDataTemplateSelector x:Key="FeedTemplateSelector" MyTemplate="{StaticResource myPartyTemplate}" InviteTemplate="{StaticResource partyTemplate}"/>
    </ContentPage.Resources>
    <ContentPage.Content>
        <AbsoluteLayout>

            <ListView x:Name="feedListView" VerticalScrollBarVisibility="Never" SeparatorVisibility="None" Scrolled="feedListView_Scrolled" CachingStrategy="RecycleElement" BackgroundColor="Black" Refreshing="RefreshView_Refreshing" RefreshControlColor="White" IsPullToRefreshEnabled="True" HasUnevenRows="True" ItemTemplate="{StaticResource FeedTemplateSelector}" VerticalOptions="FillAndExpand" ItemTapped="feedListView_ItemSelected" AbsoluteLayout.LayoutBounds="1,1,1,1" AbsoluteLayout.LayoutFlags="All">
                <ListView.Footer>
                    <StackLayout x:Name="noInvitesMsg" IsVisible="false">
                        <BoxView HeightRequest="1" BackgroundColor="Gray" HorizontalOptions="Center"/>
                        <Label Text="No More Invites" TextColor="Gray" HorizontalOptions="CenterAndExpand" VerticalOptions="Center" HorizontalTextAlignment="Center" FontSize="18" Padding="15,15,15,50"/>
                    </StackLayout>

                </ListView.Footer>
                <ListView.Header>
                    <StackLayout  Padding="25,80,25,30" >
                        <StackLayout Orientation="Horizontal" Padding="0,0,0,25">

                            <Label Text="My Invites" TextColor="White" FontSize="30" VerticalTextAlignment="Center" FontAttributes="Bold" HorizontalOptions="StartAndExpand"/>
                            <ImageButton Source="button_hamburger_white" WidthRequest="25" HeightRequest="25" HorizontalOptions="End"/>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="0" HeightRequest="30" Spacing="10">
                            <Label Text="From:" TextColor="White" FontSize="16" HorizontalOptions="Start" VerticalOptions="Center"/>
                            <Frame Padding="0" HorizontalOptions="Start" BackgroundColor="#F50058" CornerRadius="15">
                                <Button Text="Friends" TextColor="White" Padding="10" FontSize="12"/>
                            </Frame>
                            <Frame Padding="0" HorizontalOptions="Start" BackgroundColor="Black" BorderColor="#F50058" CornerRadius="15">
                                <Button Text="Friends of Friends" TextColor="White" Padding="10" FontSize="12"/>
                            </Frame>
                            <Frame Padding="0" HorizontalOptions="Start" BackgroundColor="Black" BorderColor="#F50058" CornerRadius="15">
                                <Button Text="Everyone" TextColor="White" Padding="10" FontSize="12"/>
                            </Frame>
                        </StackLayout>
                    </StackLayout>
                    
                </ListView.Header>
